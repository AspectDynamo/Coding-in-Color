# Used only by local scripts (db:migrate, db:seed) and Vite/Playwright tooling. Placeholders only.
# Copy to .env and fill in. Never commit real values.

# Postgres connection string for migrate/seed scripts (Supabase: Project Settings > Database).
DATABASE_URL=postgresql://postgres:<password>@<host>:5432/postgres

# Mirrors the .dev.vars Supabase values for scripts that run outside the Worker.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional, credential pepper rotation only: the pepper being rotated away from. Leave blank normally.
CREDENTIAL_PEPPER_PREVIOUS=
