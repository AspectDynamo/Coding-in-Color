# Security headers for static assets (Workers Static Assets reads this file from the asset directory).
# API responses get their headers from the Worker's own middleware.
#
# CSP notes:
#  - script-src 'self': no inline scripts, no third-party origins.
#  - style-src 'self' + style-src-attr 'unsafe-inline': stylesheets must be same-origin; only inline
#    style="" attributes are allowed, which Recharts (SVG sizing/tooltips) and React style props need.
#  - img-src data: is for the inline SVG chevron in <select> styling. QR codes are inline SVG.
#  - blob: is not needed in CSP for CSV downloads (navigation to a download link).
/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self'; style-src-attr 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()
  X-Frame-Options: DENY
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin

/assets/*
  Cache-Control: public, max-age=31536000, immutable
